<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Per-package metadata; shared packaging props come from src/Directory.Build.props. -->
    <Description>ASP.NET Core minimal-API and diagnostics integration for AdaskoTheBeAsT.Interop.Execution: endpoint filters and IExceptionHandler mapping execution timeouts, capacity rejections, disposal, client disconnects, and argument errors to ProblemDetails, AOT-safe leak-free worker/pool diagnostics DTOs and JsonSerializerContext, and /healthz + /readyz probe mapping. Targets net11.0 and net10.0.</Description>
    <PackageTags>Interop;STA;Worker;WorkerPool;AspNetCore;MinimalApi;ProblemDetails;HealthChecks;Diagnostics;AOT</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Test" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaskoTheBeAsT.Interop.Execution\AdaskoTheBeAsT.Interop.Execution.csproj" />
    <ProjectReference Include="..\AdaskoTheBeAsT.Interop.Execution.DependencyInjection\AdaskoTheBeAsT.Interop.Execution.DependencyInjection.csproj" />
    <ProjectReference Include="..\AdaskoTheBeAsT.Interop.Execution.Hosting\AdaskoTheBeAsT.Interop.Execution.Hosting.csproj" />
  </ItemGroup>

</Project>
