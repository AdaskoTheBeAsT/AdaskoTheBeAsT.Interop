<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net481;net48;net472</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Per-package metadata; shared packaging props come from src/Directory.Build.props. -->
    <Description>Microsoft.Extensions.Hosting and HealthChecks integration for AdaskoTheBeAsT.Interop.Execution: IHostedService wrappers, IServiceProvider-aware options configuration with ValidateOnStart, inline session factory delegates, and IHealthCheck implementations that drive ExecutionWorker / ExecutionWorkerPool startup, readiness reporting, and graceful drain through the generic host lifecycle. Targets net11.0, net10.0, and net481/net48/net472.</Description>
    <PackageTags>Interop;STA;Worker;WorkerPool;Threading;Session;Hosting;IHostedService;HealthChecks;IHealthCheck;Microsoft.Extensions.Hosting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaskoTheBeAsT.Interop.Execution\AdaskoTheBeAsT.Interop.Execution.csproj" />
    <ProjectReference Include="..\AdaskoTheBeAsT.Interop.Execution.DependencyInjection\AdaskoTheBeAsT.Interop.Execution.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="[11.0.0,12.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[10.0.15,11.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.15,11.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="[10.0.15,11.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481' OR '$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="[11.0.0,12.0.0)" />
  </ItemGroup>

</Project>
