<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net481;net48;net472</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Per-package metadata; shared packaging props come from src/Directory.Build.props. -->
    <Description>Dedicated-thread worker and worker pool that serialize async work onto per-session background threads. Supports STA on Windows, configurable thread stack sizes, pre-thread and worker-thread lifecycle hooks, contextual and delegate session factories, typed queue-capacity admission rejections, execution deadlines, cancellation, session recycling, pluggable scheduling (IWorkerScheduler), and diagnostics via ActivitySource / Meter. Targets net11.0, net10.0, and net481/net48/net472.</Description>
    <PackageTags>Interop;STA;Worker;WorkerPool;Threading;Session;COM;DedicatedThread;AsyncOverSync</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Test" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481' OR '$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Threading.Channels" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="[11.0.0,12.0.0)" />
  </ItemGroup>

</Project>
