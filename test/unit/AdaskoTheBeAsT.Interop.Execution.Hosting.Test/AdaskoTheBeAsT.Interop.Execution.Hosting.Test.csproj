    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="System.Threading.Channels" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[11.0.0,12.0.0)" />
