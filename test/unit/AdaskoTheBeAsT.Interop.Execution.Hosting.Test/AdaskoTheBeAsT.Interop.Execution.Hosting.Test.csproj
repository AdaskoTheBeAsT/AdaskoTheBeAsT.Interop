    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[11.0.0,12.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdaskoTheBeAsT.Interop.Execution\AdaskoTheBeAsT.Interop.Execution.csproj" />
